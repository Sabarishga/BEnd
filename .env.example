# Copy this file to .env and fill in your own values.
# Never commit .env - it is listed in .gitignore.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/news-alerts?retryWrites=true&w=majority

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# https://newsapi.org
NEWS_API_KEY=your_news_api_key

EMAIL_USER=your_gmail_address@gmail.com
EMAIL_FROM_NAME=News Alerts

# Option A - Gmail API over HTTPS (required on Render's free plan, which blocks SMTP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option B - Gmail SMTP with an App Password
EMAIL_PASS=

CLIENT_URL=http://localhost:5173

# Optional
NEWS_CACHE_MINUTES=15
NEWS_JOB_DEBUG=false
RUN_ALERT_ON_START=false
